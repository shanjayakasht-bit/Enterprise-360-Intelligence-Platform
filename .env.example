# NEXORA Snowflake credentials.
#
# Copy this file to .env and fill in real values -- .env is already excluded
# via .gitignore and must NEVER be committed. This file only ever holds
# placeholders; no real password belongs here.

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=NEXORA_WH
SNOWFLAKE_DATABASE=NEXORA_DB
SNOWFLAKE_ROLE=your_role
